resolver 127.0.0.11 valid=10s ipv6=off;

server {
  listen 80;

  location / {
    root /usr/share/nginx/html;
    try_files $uri $uri/ =404;
  }

  # API и потоки проксируем на acestream-proxy → same-origin, без CORS
  location ~ ^/(api/|play/|stream/|playlist\.m3u) {
    proxy_pass ${PROXY_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; # прокси берёт IP зрителя отсюда
    proxy_buffering off;   # live HLS/TS — без буферизации
    proxy_read_timeout 1h; # длинные TS-потоки
  }
}
