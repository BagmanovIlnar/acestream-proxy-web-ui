resolver 127.0.0.11 valid=10s ipv6=off;

server {
  listen 80;

  location / {
    root /usr/share/nginx/html;
    try_files $uri $uri/ =404;
    add_header Cache-Control "no-cache"; # всегда перепроверять ETag — чтобы браузер не запускал устаревшие js/css
  }

  # API и потоки проксируем на acestream-proxy → same-origin, без CORS.
  # proxy_pass через переменную + resolver: nginx резолвит апстрим на запрос, а не на старте —
  # иначе при лежащем/стартующем прокси nginx падает: "host not found in upstream"
  location ~ ^/(api/|play/|stream/|playlist\.m3u) {
    set $acestream_backend "${PROXY_URL}";
    proxy_pass $acestream_backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; # прокси берёт IP зрителя отсюда
    proxy_buffering off;   # live HLS/TS — без буферизации
    proxy_read_timeout 1h; # длинные TS-потоки
  }
}
